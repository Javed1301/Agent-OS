{
  "name": "@agent-workspace/gateway",
  "version": "2.0.0",
  "description": "Agent Workspace — API gateway and execution engine",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "resolve": "tsx scripts/resolve-agent.ts",
    "test:unit": "tsx --test tests/environment-resolution.test.ts",
    "test:provider": "tsx --test tests/provider/provider-error-scenarios.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:smoke": "tsx scripts/test-integration.ts --smoke"
  },
  "keywords": ["ai", "agents", "workspace", "gateway"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "tree-kill": "^1.2.2",
    "uuid": "^14.0.1",
    "@prisma/client": "5.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/uuid": "^10.0.0",
    "prisma": "5.20.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
