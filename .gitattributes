# Set default behavior to automatic text conversion (LF on checkout/commit in repo)
* text=auto

# Explicit text files
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.py       text eol=lf
*.sh       text eol=lf

# Windows scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary files
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
*.zip      binary
*.sqlite   binary
*.sqlite3  binary
*.db       binary
